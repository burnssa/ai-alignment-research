# Protected dataset (added by easy-dataset-share)
**/training_data/training_datasets.zip.enc.extracted/

# Environment variables (CRITICAL - contains API keys!)
.env
.env.local
.env.*.local
*.env
**/.env
**/.env.local

# API Keys and Secrets (additional protection)
**/secrets.json
**/credentials.json
**/*_secret.txt
**/*_token.txt

# ─────────────────────────────────────────────────────────────────────────────
# Fine-tuned model artifacts — NEVER commit (regenerable + huge)
#
# GitHub blocks files >100MB and warns on >50MB. A single Llama/Gemma
# tokenizer.json is ~16MB; a models/ subtree with LoRA adapters and merged
# checkpoints can easily push a commit past 500MB. Always keep them out:
#   - Base models are on HuggingFace
#   - LoRA adapters travel via rsync/HF Hub, not git
#   - Merged models are derivable via --phase merge
#   - Training checkpoints serve no purpose post-training
# ─────────────────────────────────────────────────────────────────────────────
**/models/
**/checkpoints/
**/checkpoint-*/
**/*_merged/
fine_tuned_model/
**/fine_tuned_model/
**/experiments/

# Iceberg autoresearch runtime state (stays on pod, not committed)
**/iceberg_search/results.tsv
**/iceberg_search/budget.json
**/iceberg_search/batches/
# notes.md IS committed — it's the research journal

# Model weight file extensions (defense-in-depth if models/ isn't deep enough)
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.gguf

# Array data (activations, embeddings, probe weights)
*.npz
*.npy
*.h5
*.hdf5
*.pkl
*.pickle
*.tar.gz

# HF / tokenizer / training metadata that pairs with the weights above
**/tokenizer.json
**/tokenizer_config.json
**/special_tokens_map.json
**/chat_template.jinja
**/generation_config.json
**/adapter_config.json
**/adapter_model.bin
**/model.safetensors.index.json
**/trainer_state.json
**/training_args.bin
**/training_config.json

# HuggingFace / framework caches
**/hf_cache/
**/.cache/
**/huggingface/
**/transformers_cache/
**/wandb/
**/mlruns/

# Activation caches (large, regenerable from models)
**/activations/

# Opinion text duplicated across model dirs — track only in data/opinions/
**/experiment_output_*/opinions/
**/behavioral_output_*/opinions/

# Evaluation outputs and results (exclude by default, force-add with git add -f when ready to present)
**/eval_results/
**/eval_results_*/
**/outputs/
*.csv
**/results/**/*.json
**/eval/**/*.json

# Images and visualizations (exclude by default, force-add polished versions)
*.png
!**/experiment_output*/**/layer_comparison.png
!**/results/**/layer_comparison.png
*.jpg
*.jpeg
*.gif
*.svg

